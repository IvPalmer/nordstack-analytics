# Optional overrides; defaults match docker-compose.yml. Copy to .env: make and
# docker compose read it automatically. Host ports matter when 5432 or 3306 is taken.
NORDSTACK_PG_PORT=5432
NORDSTACK_MYSQL_PORT=3306
NORDSTACK_MYSQL_URL=mysql+pymysql://billing_user:billing_password@127.0.0.1:3306/billing
NORDSTACK_POSTGRES_URL=postgresql://dbt_user:dbt_password@127.0.0.1:5432/analytics
NORDSTACK_PG_HOST=127.0.0.1
NORDSTACK_PG_USER=dbt_user
NORDSTACK_PG_PASSWORD=dbt_password
NORDSTACK_PG_DB=analytics
