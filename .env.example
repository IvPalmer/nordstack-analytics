# Optional overrides; defaults match docker-compose.yml. Copy to .env: make and
# docker compose read it automatically. Change the ports when 5432 or 3306 is taken.
NORDSTACK_PG_HOST=127.0.0.1
NORDSTACK_PG_PORT=5432
NORDSTACK_PG_USER=dbt_user
NORDSTACK_PG_PASSWORD=dbt_password
NORDSTACK_PG_DB=analytics
NORDSTACK_MYSQL_HOST=127.0.0.1
NORDSTACK_MYSQL_PORT=3306
NORDSTACK_MYSQL_USER=billing_user
NORDSTACK_MYSQL_PASSWORD=billing_password
NORDSTACK_MYSQL_DB=billing
